{
    email admin@plyglo.com
}

# Общие security headers для всех сайтов
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ── Основной сайт (Nuxt SSR) ─────────────────────────────
plyglo.com {
    import security_headers
    encode gzip zstd
    reverse_proxy site:3000
}

# ── Приложение для обучения (Expo) ────────────────────────
study.plyglo.com {
    import security_headers
    encode gzip zstd
    reverse_proxy app:3000
}

api.plyglo.com {
    import security_headers
    encode gzip zstd

    # ─── Иммутабельные версии ─────────────────────────────────
    handle_path /v1/* {
        reverse_proxy {$API_V1_UPSTREAM}
    }

    handle_path /v2/* {
        reverse_proxy {$API_V2_UPSTREAM}
    }

    # ─── Latest alias ─────────────────────────────────────────
    # Всё, что пришло без префикса версии, идёт на текущую актуальную версию.
    # Промоушен = поменять API_LATEST_UPSTREAM в окружении + reload.
    handle {
        reverse_proxy {$API_UPSTREAM}
    }
}

# ── Authentik IdP ────────────────────────────────────────
auth.plyglo.com {
    import security_headers
    encode gzip zstd

    @metrics path /-/metrics/*
    respond @metrics 404

    reverse_proxy {$AUTH_UPSTREAM} {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        # X-Forwarded-For Caddy добавляет автоматически
    }
}
