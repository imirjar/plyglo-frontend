{
    email admin@plyglo.com
}

# Общие security headers для всех сайтов
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# ── Основной сайт (Nuxt SSR) ─────────────────────────────
plyglo.com {
    import security_headers
    encode gzip zstd
    reverse_proxy site:3000
}

# ── API / BFF (тот же Nuxt-контейнер) ────────────────────
api.plyglo.com {
    import security_headers
    encode gzip zstd
    reverse_proxy site:3000
}

# ── Приложение для обучения (Expo) ────────────────────────
app.plyglo.com {
    import security_headers
    encode gzip zstd
    reverse_proxy app:3000
}

# ── Authentik IdP ────────────────────────────────────────
auth.plyglo.com {
    import security_headers
    encode gzip zstd

    # Блокировка /-/metrics/ — публично не должно быть доступно
    @metrics path /-/metrics/*
    respond @metrics 404

    # rate_limit — требует плагина caddy-ratelimit (см. ниже)
    # rate_limit {
    #     zone auth_zone {
    #         key {remote_host}
    #         events 10
    #         window 1s
    #     }
    # }

    reverse_proxy http://authentik.internal.lan:9000
}