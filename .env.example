# ═══════════════════════════════════════════════════════════════════
# Plyglo — VM #1 (EDGE)
# Скопируй в .env: cp .env.example .env && chmod 600 .env
# ═══════════════════════════════════════════════════════════════════

# ── Общее ──────────────────────────────────────────────────────────
TZ=Europe/Moscow
COMPOSE_PROJECT_NAME=plyglo-edge

# ── Caddy ──────────────────────────────────────────────────────────
# Email для Let's Encrypt (ACME). Используется в Caddyfile как {$CADDY_EMAIL}
CADDY_EMAIL=admin@plyglo.com

# ═══════════════════════════════════════════════════════════════════
# NUXT — ПУБЛИЧНЫЕ URL (видны в браузере, попадают в SSR/клиент)
# ═══════════════════════════════════════════════════════════════════
# Основной сайт
NUXT_PUBLIC_SITE_URL=https://plyglo.com
# BFF + API (тот же контейнер site)
NUXT_PUBLIC_API_URL=https://api.plyglo.com
# Authentik (для редиректов на логин)
NUXT_PUBLIC_AUTH_URL=https://auth.plyglo.com

# ═══════════════════════════════════════════════════════════════════
# NUXT — OIDC (из Authentik, см. README VM#2, раздел 10)
# ═══════════════════════════════════════════════════════════════════
# Issuer должен ТОЧНО совпадать с тем, что отдаёт Authentik
# Проверка: curl -s https://auth.plyglo.com/application/o/plyglo-api/.well-known/openid-configuration | jq .issuer
NUXT_OIDC_ISSUER=https://auth.plyglo.com/application/o/plyglo-api/

# Client ID и Secret из провайдера plyglo-api в Authentik
NUXT_OIDC_CLIENT_ID=CHANGE_ME__из_Authentik
NUXT_OIDC_CLIENT_SECRET=CHANGE_ME__из_Authentik

# Должен быть зарегистрирован в Authentik как Redirect URI
NUXT_OIDC_REDIRECT_URI=https://api.plyglo.com/auth/callback

# ═══════════════════════════════════════════════════════════════════
# NUXT — REDIS (сессии + CSRF, VM#2)
# ═══════════════════════════════════════════════════════════════════
# Формат: redis://:PASSWORD@HOST:PORT
# PASSWORD = REDIS_SESSIONS_PASSWORD из .env на VM#2
# HOST     = 10.10.2.11 (если сеть на 10.10.x) или 192.168.0.x (см. примечание)
NUXT_REDIS_URL=redis://:CHANGE_ME__REDIS_SESSIONS_PASSWORD@10.10.2.11:6379

# ═══════════════════════════════════════════════════════════════════
# NUXT — СЕКРЕТЫ (генерировать один раз, не менять без причины)
# ═══════════════════════════════════════════════════════════════════
# Секрет для подписи временных кук (state, code_verifier при OIDC flow)
# Генерация: openssl rand -hex 32
NUXT_SESSION_SECRET=CHANGE_ME__openssl_rand_hex_32

# Ключ AES-GCM для шифрования refresh_token в Redis (64 hex-символа)
# Генерация: openssl rand -hex 32
# ВАЖНО: если сменить — все сохранённые сессии станут нерасшифровываемыми,
#         пользователи перелогинятся
NUXT_ENCRYPTION_KEY=CHANGE_ME__openssl_rand_hex_32

# ═══════════════════════════════════════════════════════════════════
# NUXT — ПАРАМЕТРЫ СЕССИИ
# ═══════════════════════════════════════════════════════════════════
# Абсолютный максимум жизни сессии (секунды). 30 дней
NUXT_SESSION_TTL=2592000
# Idle timeout: разлогин, если нет активности N секунд. 7 дней
NUXT_SESSION_IDLE_TIMEOUT=604800

# ═══════════════════════════════════════════════════════════════════
# NUXT — ВНУТРЕННИЕ СЕРВИСЫ (VM#3)
# ═══════════════════════════════════════════════════════════════════
# Адреса микросервисов на VM#3. Nuxt BFF проксирует /api/* сюда
NUXT_COURSES_URL=http://courses.internal.lan:8001
NUXT_PROGRESS_URL=http://progress.internal.lan:8002
NUXT_USERS_URL=http://users.internal.lan:8003

# ═══════════════════════════════════════════════════════════════════
# NUXT — CORS
# ═══════════════════════════════════════════════════════════════════
# Origin'ы, которым разрешено ходить на api.plyglo.com с credentials
# Разделитель — запятая, без пробелов
NUXT_CORS_ORIGINS=https://plyglo.com,https://study.plyglo.com
